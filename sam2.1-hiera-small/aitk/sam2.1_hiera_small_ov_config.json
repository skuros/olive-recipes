{
    "input_model": {
        "type": "OnnxModel",
        "model_path": "model/sam2_encoder.onnx",
        "prepare_model": {
            "user_script": "sam2_1_hiera_small.py",
            "fn": "export_sam2_to_onnx",
            "kwargs": {
                "model_id": "facebook/sam2.1-hiera-small",
                "onnx_path": "model/sam2_encoder.onnx",
                "opset": 17
            }
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "npu",
                    "execution_providers": [
                        "OpenVINOExecutionProvider"
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "quantization_data_config",
            "type": "HuggingfaceContainer",
            "model_name": "facebook/sam2.1-hiera-small",
            "task": "image-segmentation",
            "user_script": "sam2_1_hiera_small.py",
            "load_dataset_config": {
                "type": "load_dataset_fn",
                "data_name": "nielsr/coco-panoptic-val2017",
                "split": "validation",
                "streaming": true,
                "trust_remote_code": true
            },
            "pre_process_data_config": {
                "type": "dataset_pre_process",
                "size": 128,
                "cache_key": "sam2_quantization"
            },
            "post_process_data_config": {
                "type": "dataset_post_process"
            }
        },
        {
            "name": "latency_data_config",
            "type": "HuggingfaceContainer",
            "model_name": "facebook/sam2.1-hiera-small",
            "task": "image-segmentation",
            "user_script": "sam2_1_hiera_small.py",
            "load_dataset_config": {
                "type": "load_dataset_fn",
                "data_name": "nielsr/coco-panoptic-val2017",
                "split": "validation",
                "streaming": true,
                "trust_remote_code": true
            },
            "pre_process_data_config": {
                "type": "dataset_pre_process",
                "size": 32,
                "cache_key": "sam2_latency"
            },
            "post_process_data_config": {
                "type": "dataset_post_process"
            }
        }
    ],
    "evaluators": {
        "latency_evaluator": {
            "metrics": [
                {
                    "name": "latency",
                    "type": "latency",
                    "data_config": "latency_data_config",
                    "sub_types": [
                        {
                            "name": "avg",
                            "priority": 1,
                            "metric_config": {
                                "warmup_num": 10,
                                "repeat_test_num": 50
                            }
                        }
                    ]
                }
            ]
        }
    },
    "passes": {
        "ov_convert": {
            "type": "OpenVINOConversion",
            "input_shapes": [
                [
                    1,
                    3,
                    1024,
                    1024
                ]
            ],
            "output_model": "sam2.1_hiera_small",
            "compress_to_fp16": true
        },
        "io_update": {
            "type": "OpenVINOIoUpdate",
            "input_shapes": [
                [
                    1,
                    3,
                    224,
                    224
                ]
            ],
            "static": false,
            "reuse_cache": true
        },
        "ov_quantize": {
            "type": "OpenVINOQuantization",
            "target_device": "npu",
            "data_config": "quantization_data_config",
            "reuse_cache": true
        },
        "encapsulation": {
            "type": "OpenVINOEncapsulation",
            "target_device": "npu",
            "ov_version": "2025.1",
            "reuse_cache": true
        }
    },
    "search_strategy": false,
    "target": "local_system",
    "cache_dir": "cache",
    "evaluate_input_model": false,
    "evaluator": "latency_evaluator",
    "output_dir": "model/sam2.1_hiera_small"
}